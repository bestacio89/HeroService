<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="AjnaTellus" value="https://pkgs.dev.azure.com/EntelekheiaSystems/_packaging/AjnaTellus/nuget/v3/index.json" />
  </packageSources>
  <configuration>
    <packageSourceCredentials>
      <AjnaTellus>
        <add key="Username" value="Bernardo" />
        <add key="Password" value="5lI38uKAjrJu4tlkd7iTrOM8UEWOGpx5thn6Oj8RTUufpMwo9X5eJQQJ99BIACAAAAAc3GLLAAASAZDO2y9j" />
      </AjnaTellus>
    </packageSourceCredentials>
  </configuration>
  <packageSourceMapping>
    <!-- All your internal Franz packages come ONLY from AjnaTellus -->
    <packageSource key="AjnaTellus">
      <package pattern="Franz.Common.*" />
    </packageSource>

    <!-- Everything else defaults to nuget.org -->
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
