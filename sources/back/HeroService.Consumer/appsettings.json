{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/messaging-log-.txt",
          "rollingInterval": "Day"
        }
      }
    ]
  },
  "Database": {
    "Provider": "Postgres",
    "ServerName": "localhost",
    "DatabaseName": "GameProject",
    "UserName": "postgres",
    "Password": "postgres",
    "Port": 5432,
    "Ssl": "Disable"
  },
  "Caching": {
    "DefaultAbsoluteExpiration": "00:05:00",
    "DefaultSlidingExpiration": "00:02:00",
    "KeyPrefix": "HeroServiceConsumer",
    "ConnectionString": "localhost:6379"
  },
  "Messaging": {
    "Provider": "kafka",
    "Kafka": {
      "BootstrapServers": "",
      "GroupId": "hero-service-consumer",
      "TopicName": "",
      "Security": {
        "SecurityProtocol": "SaslSsl",
        "SaslMechanism": "ScramSha512",
        "SaslUsername": "",
        "SaslPassword": "",
        "SslCaLocation": "",
        "SslCertificateLocation": "",
        "SslKeyLocation": ""
      },
      "Consumer": {
        "AutoOffsetReset": "Earliest",
        "EnableAutoCommit": false,
        "EnableAutoOffsetStore": false,
        "SessionTimeoutMs": 45000,
        "MaxPollIntervalMs": 300000,
        "MaxPollRecords": 100,
        "FetchMinBytes": 1,
        "FetchMaxBytes": 52428800,
        "FetchWaitMaxMs": 500,
        "ConcurrencyLevel": 1
      },
      "Producer": {
        "Acks": "All",
        "MessageMaxBytes": 1048576,
        "LingerMs": 5,
        "BatchSize": 16384,
        "CompressionType": "Snappy",
        "EnableIdempotence": true,
        "MessageSendMaxRetries": 3,
        "RetryBackoffMs": 100,
        "DeliveryTimeoutMs": 120000
      },
      "Failure": {
        "EnableDeadLetter": true,
        "DeadLetterTopic": "",
        "MaxRetryAttempts": 3,
        "RetryBackoffMs": 500,
        "UseOriginalMessageKey": true
      },
      "Observability": {
        "EnableMetrics": true,
        "EnableTracing": true,
        "EnableLogging": true,
        "LogMessagePayloads": false
      }
    },
    "Outbox": {
      "Enabled": true,
      "FlushIntervalSeconds": 10,
      "MaxBatchSize": 100
    },
    "Context": {
      "IncludeTenant": true,
      "IncludeCorrelationId": true,
      "IncludeUserIdentity": true
    },
    "Policies": {
      "RetryPolicy": "RetryPolicy",
      "CircuitBreakerPolicy": "CircuitBreaker",
      "TimeoutPolicy": "TimeoutPolicy"
    }
  },
  "Resilience": {
    "RetryPolicy": {
      "Enabled": true,
      "RetryCount": 3,
      "RetryIntervalMilliseconds": 500
    },
    "CircuitBreaker": {
      "Enabled": true,
      "FailureThreshold": 0.5,
      "MinimumThroughput": 10,
      "DurationOfBreakSeconds": 30
    },
    "TimeoutPolicy": {
      "Enabled": true,
      "TimeoutSeconds": 5
    },
    "BulkheadPolicy": {
      "Enabled": true,
      "MaxParallelization": 10,
      "MaxQueueSize": 20
    }
  },
  "Tracing": {
    "OpenTelemetry": {
      "Enabled": true,
      "SourceName": "Franz.Messaging",
      "Exporter": "jaeger",
      "Endpoint": "http://localhost:14268/api/traces"
    }
  },
  "TIdType": "Int",
  "TenantStrategy": "Header",
  "Environment": "Production"
}
