{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/messaging-log-.txt",
          "rollingInterval": "Day"
        }
      }
    ]
  },

  "Database": {
    "Provider": "mariadb",
    "ServerName": "localhost",
    "DatabaseName": "{dbName}",
    "UserName": "root",
    "Password": "password",
    "Port": 3308,
    "SslMode": "Preferred"
  },

  "Messaging": {
    "Provider": "kafka",

    "Transport": {
      "HostName": "localhost",
      "Port": 5672,
      "UserName": "guest",
      "Password": "guest",
      "VirtualHost": "/",
      "SslEnabled": false
    },

    "Kafka": {
      "BootstrapServers": "localhost:9092",
      "TopicPrefix": "franz",

      "Security": {
        "SecurityProtocol": "Plaintext",
        "SaslMechanism": "Plain",
        "SaslUsername": "",
        "SaslPassword": "",
        "SslCaLocation": "",
        "SslCertificateLocation": "",
        "SslKeyLocation": ""
      },

      "Consumer": {
        "GroupId": "franz-consumer-group",
        "AutoOffsetReset": "Earliest",
        "EnableAutoCommit": false,
        "EnableAutoOffsetStore": false,
        "SessionTimeoutMs": 45000,
        "MaxPollIntervalMs": 300000,
        "FetchMaxBytes": 52428800
      },

      "Producer": {
        "Acks": "All",
        "MessageMaxBytes": 1048576,
        "LingerMs": 5,
        "BatchSize": 16384,
        "CompressionType": "Snappy",
        "EnableIdempotence": true
      }
    },

    "Outbox": {
      "Enabled": true,
      "FlushIntervalSeconds": 10,
      "MaxBatchSize": 100
    },

    "Context": {
      "IncludeTenant": true,
      "IncludeCorrelationId": true,
      "IncludeUserIdentity": true
    },

    "Policies": {
      "RetryPolicy": "RetryPolicy",
      "CircuitBreakerPolicy": "CircuitBreaker",
      "TimeoutPolicy": "TimeoutPolicy"
    }
  },

  "Resilience": {
    "RetryPolicy": {
      "Enabled": true,
      "RetryCount": 3,
      "RetryIntervalMilliseconds": 500
    },
    "CircuitBreaker": {
      "Enabled": true,
      "FailureThreshold": 0.5,
      "MinimumThroughput": 10,
      "DurationOfBreakSeconds": 30
    },
    "TimeoutPolicy": {
      "Enabled": true,
      "TimeoutSeconds": 5
    },
    "BulkheadPolicy": {
      "Enabled": true,
      "MaxParallelization": 10,
      "MaxQueueSize": 20
    }
  },

  "Tracing": {
    "OpenTelemetry": {
      "Enabled": true,
      "SourceName": "Franz.Messaging",
      "Exporter": "jaeger",
      "Endpoint": "http://localhost:14268/api/traces"
    }
  },

  "TIdType": "Int",
  "TenantStrategy": "Header",
  "Environment": "Development"
}