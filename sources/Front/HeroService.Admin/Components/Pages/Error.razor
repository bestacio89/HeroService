@namespace HeroService.Admin.Components.Pages

@page "/Error"

<PageTitle>Error</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small"
              Class="mt-12">

    <MudPaper Class="pa-6"
              Elevation="4">

        <MudStack Spacing="3"
                  AlignItems="AlignItems.Center">

            <MudIcon Icon="@Icons.Material.Filled.ErrorOutline"
                     Size="Size.Large"
                     Color="Color.Error" />


            <MudText Typo="Typo.h4"
                     Align="Align.Center">
                System Error
            </MudText>


            <MudText Typo="Typo.body1"
                     Color="Color.Secondary"
                     Align="Align.Center">
                An unexpected error occurred while processing your request.
            </MudText>


            @if (ShowRequestId)
            {
                <MudPaper Class="pa-3 mt-3"
                          Outlined="true">

                    <MudText Typo="Typo.caption">
                        Correlation Identifier
                    </MudText>


                    <MudText Typo="Typo.body2">
                        @RequestId
                    </MudText>

                </MudPaper>
            }


            <MudDivider Class="my-3" />


            <MudAlert Severity="Severity.Warning">

                Detailed error information is only available
                in the Development environment.

            </MudAlert>


            <MudText Typo="Typo.body2"
                     Align="Align.Center">

                Please contact support if the problem persists
                and provide the correlation identifier above.

            </MudText>

        </MudStack>

    </MudPaper>

</MudContainer>