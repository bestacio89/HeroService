@page "/"
@using MudBlazor
@inject NavigationManager Nav
@rendermode InteractiveServer

<PageTitle>Codex Hub</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large">

    <!-- HEADER -->
    <MudText Typo="Typo.h4" Class="mb-1">
        Codex Management System
    </MudText>

    <MudText Typo="Typo.subtitle2" Color="Color.Secondary" Class="mb-4">
        Author heroes, skills and world structures for gameplay generation
    </MudText>

    <MudDivider Class="mb-6" />

    <!-- PRIMARY WORKFLOW -->
    <MudText Typo="Typo.h6" Class="mb-2">
        Core Authoring Pipeline
    </MudText>

    <MudGrid Spacing="3">

        <!-- HEROES -->
        <MudItem xs="12" md="6">
            <MudPaper Class="pa-4" Elevation="3">

                <MudText Typo="Typo.h6">Heroes</MudText>

                <MudText Typo="Typo.body2" Class="mb-3">
                    Create and define hero identity, stats, affiliation and skill kits.
                </MudText>

                <MudStack Row="true" Spacing="2">

                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               OnClick="@(() => Nav.NavigateTo("/admin/heroes"))">
                        Manage Heroes
                    </MudButton>

                    <MudButton Variant="Variant.Outlined"
                               OnClick="@(() => Nav.NavigateTo("/admin/heroes/create"))">
                        Create Hero
                    </MudButton>

                </MudStack>

            </MudPaper>
        </MudItem>

        <!-- SKILLS -->
        <MudItem xs="12" md="6">
            <MudPaper Class="pa-4" Elevation="3">

                <MudText Typo="Typo.h6">Skills System</MudText>

                <MudText Typo="Typo.body2" Class="mb-3">
                    Define abilities, effects, scaling and execution logic.
                </MudText>

                <MudStack Row="true" Spacing="2">

                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               OnClick="@(() => Nav.NavigateTo("/skills"))">
                        Skills Library
                    </MudButton>

                    <MudButton Variant="Variant.Outlined"
                               OnClick="@(() => Nav.NavigateTo("/skills/create"))">
                        Forge Skill
                    </MudButton>

                </MudStack>

            </MudPaper>
        </MudItem>

    </MudGrid>

    <MudDivider Class="my-6" />

    <!-- WORLD / CLASSIFICATIONS -->
    <MudText Typo="Typo.h6" Class="mb-2">
        World & Classifications
    </MudText>

    <MudGrid Spacing="3">

        <MudItem xs="12" md="4">
            <MudPaper Class="pa-4">

                <MudText Typo="Typo.h6">Mythology</MudText>
                <MudText Typo="Typo.body2" Class="mb-2">
                    Cultural and mythological classification layer.
                </MudText>

                <MudButton Size="Size.Small"
                           OnClick="@(() => Nav.NavigateTo("/admin/mythology"))">
                    Open
                </MudButton>

            </MudPaper>
        </MudItem>

        <MudItem xs="12" md="4">
            <MudPaper Class="pa-4">

                <MudText Typo="Typo.h6">Origin Systems</MudText>
                <MudText Typo="Typo.body2" Class="mb-2">
                    Archetypes and cultural origins.
                </MudText>

                <MudStack Row="true" Spacing="1">

                    <MudButton Size="Size.Small"
                               OnClick="@(() => Nav.NavigateTo("/admin/origin-archetypes"))">
                        Archetypes
                    </MudButton>

                    <MudButton Size="Size.Small"
                               OnClick="@(() => Nav.NavigateTo("/admin/origin-cultures"))">
                        Cultures
                    </MudButton>

                </MudStack>

            </MudPaper>
        </MudItem>

        <MudItem xs="12" md="4">
            <MudPaper Class="pa-4">

                <MudText Typo="Typo.h6">Hero Classes</MudText>
                <MudText Typo="Typo.body2" Class="mb-2">
                    Combat roles and gameplay archetypes.
                </MudText>

                <MudButton Size="Size.Small"
                           OnClick="@(() => Nav.NavigateTo("/admin/hero-classes"))">
                    Manage
                </MudButton>

            </MudPaper>
        </MudItem>

    </MudGrid>

</MudContainer>