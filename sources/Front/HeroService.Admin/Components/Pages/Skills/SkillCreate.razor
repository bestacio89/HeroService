@page "/skills/create"

@using HeroService.Client.Http.Abstractions
@using HeroService.Contracts.Commands.Skills
@using HeroService.Contracts.DTOs.Skills
@using HeroService.Domain.Heroes.Skills
@using MudBlazor
@rendermode InteractiveServer
@inject ISkillClient SkillClient
@inject NavigationManager Nav

<MudText Typo="Typo.h5">Create Skill</MudText>

<MudPaper Class="pa-4 mt-3">

    <MudTextField T="string"
                  @bind-Value="name"
                  Label="Name"
                  Required="true" />

    <MudSelect T="SkillType"
               @bind-Value="type"
               Label="Skill Type"
               Class="mt-3">

        @foreach (var t in Enum.GetValues<SkillType>())
        {
            <MudSelectItem Value="@t">@t</MudSelectItem>
        }

    </MudSelect>

    <MudButton Class="mt-4"
               Variant="Variant.Filled"
               Color="Color.Primary"
               Disabled="@string.IsNullOrWhiteSpace(name)"
               OnClick="Create">
        Create
    </MudButton>

</MudPaper>

@code {
    private string name = string.Empty;
    private SkillType type;

    private async Task Create()
    {
        var command = new CreateSkillCommand(
            name,
            type.ToString(),

            new SkillLoreDto
            {
                Description = string.Empty,
                VisualExplanation = string.Empty
            },

            new SkillBaseStatsDto
            {
                Cooldown = 0,
                ManaCost = 0,
                Damage = 0,
                Healing = 0,
                ShieldValue = 0,
                CastTime = 0,
                ChannelDuration = 0,
                Range = 0,
                CrowdControlDuration = 0
            },

            new List<SkillEffectDto>()
        );

        var id = await SkillClient.CreateSkillAsync(command);

        Nav.NavigateTo($"/skills/{id}");
    }
}