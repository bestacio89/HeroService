@page "/skills"
@rendermode InteractiveServer
@using HeroService.Client.Http.Abstractions
@using HeroService.Contracts.DTOs.Skills
@using MudBlazor

@inject ISkillClient SkillClient
@inject NavigationManager Nav

<MudText Typo="Typo.h5">Skills</MudText>

<MudButton Variant="Variant.Filled"
           Color="Color.Primary"
           Class="mb-3"
           OnClick="@(() => Nav.NavigateTo("/skills/create"))">
    Create Skill
</MudButton>

@if (skills is null)
{
    <MudProgressCircular Indeterminate="true" />
}
else
{
    <MudTable T="SkillDto"
              Items="skills"
              Hover="true"
              Dense="true"
              Class="mt-4">

        <HeaderContent>
            <MudTh>Name</MudTh>
            <MudTh>Type</MudTh>
            <MudTh>Effects</MudTh>
            <MudTh></MudTh>
        </HeaderContent>

        <RowTemplate Context="skill">
            <MudTd DataLabel="Name">
                @skill.Name
            </MudTd>

            <MudTd DataLabel="Type">
                @skill.SkillType
            </MudTd>

            <MudTd DataLabel="Effects">
                @(skill.Effects?.Count ?? 0)
            </MudTd>

            <MudTd>
                <MudButton Size="Size.Small"
                           Variant="Variant.Text"
                           OnClick="@(() => Nav.NavigateTo($"/skills/{skill.Id}"))">
                    Open
                </MudButton>
            </MudTd>
        </RowTemplate>

    </MudTable>
}

@code {
    private IReadOnlyCollection<SkillDto>? skills;

    protected override async Task OnInitializedAsync()
    {
        skills = SkillUiSeed.Data;
        await Task.CompletedTask;
    }
}