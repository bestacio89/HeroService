<LifecycleAdminPage TDto="OriginArchetypeDto"
                    Title="Origin Archetypes"
                    Items="Items"
                    IsLoading="IsLoading"
                    OnCreate="Create"
                    OnRename="Rename"
                    OnRetire="Retire">

    <HeaderContent>

        <MudTh>Name</MudTh>

        <MudTh>
            Status
        </MudTh>

    </HeaderContent>


    <RowTemplate Context="item">

        <MudTd>
            @item.Name
        </MudTd>


        <MudTd>

            <MudChip T="string"
                     Color="Color.Success"
                     Size="Size.Small">
                Active
            </MudChip>

        </MudTd>

    </RowTemplate>

</LifecycleAdminPage>