@page "/admin/origin-archetypes"
@namespace HeroService.Admin.Components.Pages.Admin.OriginArchetypes

<PageTitle>Origin Archetypes | HeroService</PageTitle>

<LifecycleAdminPage TDto="OriginArchetypeDto"
                    Title="Origin Archetypes"
                    Description="Manage foundational character patterns and origin classifications."
                    Items="Items"
                    IsLoading="IsLoading"
                    ErrorMessage="@ErrorMessage"
                    SearchPlaceholder="Search origin archetypes"
                    SearchTextSelector="@(item => item.Name)"
                    OnRefresh="Load"
                    OnCreate="Create"
                    OnRename="Rename"
                    OnRetire="Retire">
    <HeaderContent>
        <MudTh>Name</MudTh>
        <MudTh>Classification</MudTh>
    </HeaderContent>
    <RowTemplate Context="item">
        <MudTd DataLabel="Name">@item.Name</MudTd>
        <MudTd DataLabel="Classification">
            <MudChip T="string" Color="Color.Info" Size="Size.Small" Variant="Variant.Outlined">Archetype</MudChip>
        </MudTd>
    </RowTemplate>
</LifecycleAdminPage>
