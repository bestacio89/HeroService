@page "/admin/origin-archetypes"
@using HeroService.Client.Http.Abstractions
@using MudBlazor
@using HeroService.Contracts.DTOs.Heroes
@using HeroService.Contracts.Commands.Heroes.Classifications.OriginArchetypes
@inject IOriginArchetypeClient Client
@inject IDialogService DialogService

<LifecycleAdminPage TDto="OriginArchetypeDto"
                    TCreate="CreateOriginArchetypeCommand"
                    TRename="RenameOriginArchetypeCommand"
                    Title="Origin Archetypes"
                    Items="Items"
                    IsLoading="IsLoading"
                    OnRefresh="Load"
                    OnCreate="Create"
                    OnRename="Rename"
                    OnRetire="Retire">

    <HeaderContent>
        <MudTh>Name</MudTh>
    </HeaderContent>

    <RowTemplate Context="item">
        <MudTd>@item.Name</MudTd>
    </RowTemplate>

</LifecycleAdminPage>

@code {
    private IReadOnlyList<OriginArchetypeDto> Items = [];
    private bool IsLoading = true;

    protected override async Task OnInitializedAsync()
        => await Load();

    private async Task Load()
    {
        IsLoading = true;
        Items = await Client.GetAllAsync();
        IsLoading = false;
    }

    private async Task Create()
    {
        var dialog = await DialogService.ShowAsync<OriginArchetypeDialog>("Create");
        await dialog.Result;
        await Load();
    }

    private async Task Rename(OriginArchetypeDto item)
    {
        var dialog = await DialogService.ShowAsync<OriginArchetypeDialog>(
            "Rename",
            new DialogParameters { ["Item"] = item });

        await dialog.Result;
        await Load();
    }

    private async Task Retire(OriginArchetypeDto item)
    {
        await Client.RetireAsync(item.Id);
        await Load();
    }
}