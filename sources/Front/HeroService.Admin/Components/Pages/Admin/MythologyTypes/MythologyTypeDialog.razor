@namespace HeroService.Admin.Components.Pages.Admin.MythologyTypes

<MudDialog>

    <DialogContent>

        <MudText Typo="Typo.h6">
            @(IsEdit ? "Rename Mythology Type" : "Create Mythology Type")
        </MudText>

        <MudTextField Label="Name"
                      @bind-Value="Name"
                      Required="true" />

    </DialogContent>

    <DialogActions>

        <MudButton OnClick="Cancel">
            Cancel
        </MudButton>

        <MudButton Color="Color.Primary"
                   OnClick="Save"
                   Disabled="@string.IsNullOrWhiteSpace(Name)">
            Save
        </MudButton>

    </DialogActions>

</MudDialog>