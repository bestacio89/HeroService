@namespace HeroService.Admin.Components.Pages.Admin.MythologyTypes

@page "/admin/mythology-types"

<MudPaper Class="pa-4">

    <MudStack Row="true"
              Justify="Justify.SpaceBetween"
              AlignItems="AlignItems.Center">

        <MudText Typo="Typo.h5">
            Mythology Types
        </MudText>

        <MudButton Color="Color.Primary"
                   Variant="Variant.Filled"
                   OnClick="@(() => Nav.NavigateTo("/admin/mythology-types/create"))">
            Create Mythology Type
        </MudButton>

    </MudStack>

    <MudDivider Class="my-3" />

    <MudTable Items="_items"
              Hover="true"
              Striped="true">

        <HeaderContent>
            <MudTh>Name</MudTh>
            <MudTh></MudTh>
        </HeaderContent>

        <RowTemplate Context="item">

            <MudTd>
                @item.Name
            </MudTd>

            <MudTd>
                <MudButton Icon="@Icons.Material.Filled.Edit"
                           Size="Size.Small"
                           OnClick="@(() => Nav.NavigateTo($"/admin/mythology-types/{item.Id}"))">
                    Manage
                </MudButton>
            </MudTd>

        </RowTemplate>

    </MudTable>

</MudPaper>