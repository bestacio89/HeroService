@namespace HeroService.Admin.Components.Pages.Admin.MythologyTypes
@page "/admin/mythology-types"

<PageTitle>Mythology Types | HeroService</PageTitle>

<LifecycleAdminPage TDto="MythologyTypeDto"
                    Title="Mythology Types"
                    Description="Manage narrative traditions and cultural frameworks."
                    Items="Items"
                    IsLoading="IsLoading"
                    ErrorMessage="@ErrorMessage"
                    SearchPlaceholder="Search mythology types"
                    SearchTextSelector="@(item => item.Name)"
                    OnRefresh="Load"
                    OnCreate="Create"
                    OnRename="Rename"
                    OnRetire="Retire">
    <HeaderContent>
        <MudTh>Name</MudTh>
        <MudTh>Classification</MudTh>
    </HeaderContent>
    <RowTemplate Context="item">
        <MudTd DataLabel="Name"><MudText Typo="Typo.subtitle2">@item.Name</MudText></MudTd>
        <MudTd DataLabel="Classification">
            <MudChip T="string" Color="Color.Tertiary" Size="Size.Small" Variant="Variant.Outlined">Mythology</MudChip>
        </MudTd>
    </RowTemplate>
</LifecycleAdminPage>
