@page "/admin/skill-modifiers"
@namespace HeroService.Admin.Components.Pages.Admin.SkillModifiers

<PageTitle>Skill Modifiers</PageTitle>

<MudPaper Class="pa-4">

    <MudStack Spacing="3">

        <MudStack Row="true"
                  Justify="Justify.SpaceBetween"
                  AlignItems="AlignItems.Center">

            <MudStack Spacing="0">

                <MudText Typo="Typo.h5">
                    Skill Modifiers
                </MudText>

                <MudText Typo="Typo.body2"
                         Color="Color.Secondary">
                    Manage skill balance adjustments by game version.
                </MudText>

            </MudStack>


            <div class="admin-page-actions">
                <MudIconButton Icon="@Icons.Material.Filled.Refresh" Color="Color.Default" Title="Refresh modifiers" AriaLabel="Refresh modifiers" Disabled="@Loading" OnClick="LoadAsync" />
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenCreateDialog">Create Modifier</MudButton>
            </div>

        </MudStack>


        <MudDivider />

        @if (!string.IsNullOrWhiteSpace(ErrorMessage))
        {
            <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">
                <MudText Typo="Typo.subtitle1">Skill modifiers could not be loaded</MudText>
                <MudText Typo="Typo.body2">@ErrorMessage</MudText>
                <MudButton Class="mt-2" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Refresh" OnClick="LoadAsync">Try again</MudButton>
            </MudAlert>
        }

        <MudTable Items="Modifiers"
                  Hover="true"
                  Dense="true"
                  Loading="Loading">

            <HeaderContent>

                <MudTh>
                    Skill
                </MudTh>


                <MudTh>
                    Game Version
                </MudTh>


                <MudTh>
                    Damage
                </MudTh>


                <MudTh>
                    Cooldown
                </MudTh>


                <MudTh>
                    Mana Cost
                </MudTh>


                <MudTh>
                    Healing
                </MudTh>


                <MudTh>
                    Range
                </MudTh>


                <MudTh>
                    Actions
                </MudTh>

            </HeaderContent>


            <RowTemplate>

                <MudTd DataLabel="Skill">

                    @GetSkillName(context.SkillId)

                </MudTd>


                <MudTd DataLabel="Game Version">

                    @ActiveGameVersion

                </MudTd>


                <MudTd DataLabel="Damage">

                    @DisplayMultiplier(context.DamageMultiplier)

                </MudTd>


                <MudTd DataLabel="Cooldown">

                    @DisplayMultiplier(context.CooldownMultiplier)

                </MudTd>


                <MudTd DataLabel="Mana Cost">

                    @DisplayMultiplier(context.ManaCostMultiplier)

                </MudTd>


                <MudTd DataLabel="Healing">

                    @DisplayMultiplier(context.HealingMultiplier)

                </MudTd>


                <MudTd DataLabel="Range">

                    @DisplayMultiplier(context.RangeMultiplier)

                </MudTd>


                <MudTd DataLabel="Actions">

                    <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                   Color="Color.Primary"
                                   Title="Edit Modifier"
                                   OnClick="@(() => OpenEditDialog(context))" />

                </MudTd>

            </RowTemplate>


            <NoRecordsContent>

                <MudText Typo="Typo.body2"
                         Color="Color.Secondary">
                    @(string.IsNullOrWhiteSpace(ErrorMessage) ? "No active skill modifiers found." : "The modifier list is unavailable. Retry the request above.")
                </MudText>

            </NoRecordsContent>


            <LoadingContent>

                <MudText Typo="Typo.body2">
                    Loading skill modifiers...
                </MudText>

            </LoadingContent>


        </MudTable>

    </MudStack>

</MudPaper>