@namespace HeroService.Admin.Components.Shared
@typeparam TDto

<MudPaper Class="admin-panel pa-4" Elevation="0">
    <div class="admin-page-heading">
        <div class="admin-page-heading-copy">
            <MudText Typo="Typo.overline" Class="eyebrow">REFERENCE DATA</MudText>
            <MudText Typo="Typo.h4" Class="page-title">@Title</MudText>
            @if (!string.IsNullOrWhiteSpace(Description))
            {
                <MudText Typo="Typo.body2" Color="Color.Secondary">@Description</MudText>
            }
        </div>
        <div class="admin-page-actions">
            @if (OnRefresh is not null)
            {
                <MudIconButton Icon="@Icons.Material.Filled.Refresh" Color="Color.Default" Title="Refresh" AriaLabel="Refresh @Title" Disabled="@IsLoading" OnClick="Refresh" />
            }
            <MudButton Color="Color.Primary" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Add" Disabled="@(OnCreate is null)" OnClick="OpenCreate">Create</MudButton>
        </div>
    </div>
    <div class="admin-list-summary">
        <MudText Typo="Typo.body2" Color="Color.Secondary">@(IsLoading ? "Loading records…" : $"{Items.Count} record{(Items.Count == 1 ? "" : "s")}")</MudText>
    </div>
    @if (IsLoading)
    {
        <div class="admin-loading-state" role="status" aria-live="polite">
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
            <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="44px" />
            <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="44px" />
            <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="44px" />
        </div>
    }
    else if (Items.Count == 0)
    {
        <MudPaper Class="empty-state" Elevation="0">
            <MudIcon Icon="@Icons.Material.Outlined.Inventory2" Size="Size.Large" Color="Color.Secondary" />
            <MudText Typo="Typo.h6">No records yet</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">Create the first record to populate this section.</MudText>
            @if (OnCreate is not null)
            {
                <MudButton Color="Color.Primary" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenCreate">Create record</MudButton>
            }
        </MudPaper>
    }
    else
    {
        <MudTable Items="Items" Hover="true" Dense="true" Breakpoint="Breakpoint.Sm" Class="admin-data-table">
            <HeaderContent>
                @if (HeaderContent is not null)
                {
                    @HeaderContent
                }
                <MudTh Style="width:120px;">Actions</MudTh>
            </HeaderContent>
            <RowTemplate Context="item">
                @if (RowTemplate is not null)
                {
                    @RowTemplate(item)
                }
                <MudTd DataLabel="Actions">
                    <div class="table-actions">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Primary" Title="Rename" AriaLabel="Rename record" Disabled="@(OnRename is null)" OnClick="@(() => OpenRename(item))" />
                        <MudIconButton Icon="@Icons.Material.Filled.Archive" Size="Size.Small" Color="Color.Error" Title="Retire" AriaLabel="Retire record" Disabled="@(OnRetire is null)" OnClick="@(() => Retire(item))" />
                    </div>
                </MudTd>
            </RowTemplate>
        </MudTable>
    }
</MudPaper>
