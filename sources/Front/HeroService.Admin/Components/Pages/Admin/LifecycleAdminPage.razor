@typeparam TDto
@typeparam TCreate
@typeparam TRename
@inject IDialogService DialogService

<MudPaper Class="pa-4">

    <MudStack Row="true"
              Justify="Justify.SpaceBetween"
              AlignItems="AlignItems.Center">

        <MudText Typo="Typo.h5">@Title</MudText>

        <MudButton Color="Color.Primary"
                   OnClick="OpenCreate">
            Create
        </MudButton>

    </MudStack>

    <MudDivider Class="my-2" />

    @if (IsLoading)
    {
        <MudProgressLinear Indeterminate="true" />
    }
    else if (Items is null || Items.Count == 0)
    {
        <MudAlert Severity="Severity.Info">
            No items found
        </MudAlert>
    }
    else
    {
        <MudTable Items="Items" Hover="true" Dense="true">

            <HeaderContent>
                @HeaderContent
                <MudTh Style="width:120px;">Actions</MudTh>
            </HeaderContent>

            <RowTemplate>
                @RowTemplate(context)

                <MudTd>
                    <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                   OnClick="@(() => OpenRename(context))" />

                    <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                   OnClick="@(() => Retire(context))" />
                </MudTd>
            </RowTemplate>

        </MudTable>
    }

</MudPaper>
@code {
    [Parameter] public string Title { get; set; } = "";

    [Parameter] public IReadOnlyList<TDto> Items { get; set; } = [];

    [Parameter] public Func<Task> OnRefresh { get; set; } = default!;

    [Parameter] public RenderFragment HeaderContent { get; set; } = default!;

    [Parameter] public RenderFragment<TDto> RowTemplate { get; set; } = default!;

    [Parameter] public Func<Task> OnCreate { get; set; } = default!;

    [Parameter] public Func<TDto, Task> OnRename { get; set; } = default!;

    [Parameter] public Func<TDto, Task> OnRetire { get; set; } = default!;

    [Parameter] public bool IsLoading { get; set; }

    private async Task OpenCreate()
    {
        if (OnCreate is not null)
            await OnCreate();
    }

    private async Task OpenRename(TDto item)
    {
        if (OnRename is not null)
            await OnRename(item);
    }

    private async Task Retire(TDto item)
    {
        if (OnRetire is not null)
            await OnRetire(item);
    }
}
