@namespace HeroService.Admin.Components.Shared
@typeparam TDto

<MudPaper Class="admin-panel pa-4" Elevation="0">
    <div class="admin-page-heading">
        <div class="admin-page-heading-copy">
            <MudText Typo="Typo.overline" Class="eyebrow">REFERENCE DATA</MudText>
            <h1 class="mud-typography mud-typography-h4 page-title">@Title</h1>
            @if (!string.IsNullOrWhiteSpace(Description))
            {
                <MudText Typo="Typo.body2" Color="Color.Secondary">@Description</MudText>
            }
        </div>
        <div class="admin-page-actions">
            @if (OnRefresh.HasDelegate)
            {
                <MudIconButton Icon="@Icons.Material.Filled.Refresh"
                               Color="Color.Default"
                               Title="Refresh"
                               aria-label="Refresh list"
                               Disabled="@(!CanRunActions)"
                               OnClick="Refresh" />
            }
            <MudButton Color="Color.Primary"
                       Variant="Variant.Filled"
                       StartIcon="@Icons.Material.Filled.Add"
                       Disabled="@(!OnCreate.HasDelegate || !CanRunActions)"
                       OnClick="OpenCreate">
                Create
            </MudButton>
        </div>
    </div>

    @if (SearchTextSelector is not null)
    {
        <MudTextField T="string"
                      Value="@_search"
                      ValueChanged="OnSearchChanged"
                      Placeholder="@SearchPlaceholder"
                      AriaLabel="@SearchPlaceholder"
                      Variant="Variant.Outlined"
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search"
                      Immediate="true"
                      DebounceInterval="200"
                      Clearable="true"
                      Disabled="@IsLoading"
                      Class="catalogue-search" />
    }

    <div class="admin-list-summary">
        <MudText Typo="Typo.body2" Color="Color.Secondary">
            @(IsLoading ? "Loading records…" : !string.IsNullOrWhiteSpace(ErrorMessage) ? "Records unavailable" : SearchTextSelector is null ? $"{Items.Count} record{(Items.Count == 1 ? "" : "s")}" : $"{FilteredItems.Count} of {Items.Count} records")
        </MudText>
    </div>

    @if (IsLoading)
    {
        <div class="admin-loading-state" role="status" aria-live="polite">
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
            <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="44px" />
            <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="44px" />
            <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="44px" />
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Role="alert">
            <MudText Typo="Typo.subtitle1">Records could not be loaded</MudText>
            <MudText Typo="Typo.body2">@ErrorMessage</MudText>
            @if (OnRefresh.HasDelegate)
            {
                <MudButton Class="mt-3"
                           Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Refresh"
                           Disabled="@(!CanRunActions)"
                           OnClick="Refresh">
                    Try again
                </MudButton>
            }
        </MudAlert>
    }
    else if (Items.Count == 0)
    {
        <MudPaper Class="empty-state" Elevation="0">
            <MudIcon Icon="@Icons.Material.Outlined.Inventory2" Size="Size.Large" Color="Color.Secondary" />
            <MudText Typo="Typo.h6">No records yet</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">Create the first record to populate this section.</MudText>
            @if (OnCreate.HasDelegate)
            {
                <MudButton Color="Color.Primary"
                           Variant="Variant.Outlined"
                           StartIcon="@Icons.Material.Filled.Add"
                           Disabled="@(!CanRunActions)"
                           OnClick="OpenCreate">
                    Create record
                </MudButton>
            }
        </MudPaper>
    }
    else if (FilteredItems.Count == 0)
    {
        <MudPaper Class="empty-state" Elevation="0">
            <MudIcon Icon="@Icons.Material.Outlined.SearchOff" Size="Size.Large" Color="Color.Secondary" />
            <MudText Typo="Typo.h6">No matching records</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">Try a different search term.</MudText>
            <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="ClearSearch">Clear search</MudButton>
        </MudPaper>
    }
    else
    {
        <MudTable Items="FilteredItems" Hover="true" Dense="true" Breakpoint="Breakpoint.Sm" Class="admin-data-table">
            <HeaderContent>
                @if (HeaderContent is not null)
                {
                    @HeaderContent
                }
                <MudTh Style="width:120px;">Actions</MudTh>
            </HeaderContent>
            <RowTemplate Context="item">
                @if (RowTemplate is not null)
                {
                    @RowTemplate(item)
                }
                <MudTd DataLabel="Actions">
                    <div class="table-actions">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                       Size="Size.Small"
                                       Color="Color.Primary"
                                       Title="Rename"
                                       aria-label="Rename record"
                                       Disabled="@(!OnRename.HasDelegate || !CanRunActions)"
                                       OnClick="@(() => OpenRename(item))" />
                        <MudIconButton Icon="@Icons.Material.Filled.Archive"
                                       Size="Size.Small"
                                       Color="Color.Error"
                                       Title="Retire"
                                       aria-label="Retire record"
                                       Disabled="@(!OnRetire.HasDelegate || !CanRunActions)"
                                       OnClick="@(() => Retire(item))" />
                    </div>
                </MudTd>
            </RowTemplate>
        </MudTable>
    }
</MudPaper>
