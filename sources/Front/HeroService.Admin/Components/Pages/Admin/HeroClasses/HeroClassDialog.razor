@namespace HeroService.Admin.Components.Pages.Admin.HeroClasses

<MudDialog>

    <DialogContent>

        <MudText Typo="Typo.h6">
            Create Hero Class
        </MudText>

        <MudTextField Label="Name"
                      @bind-Value="Name"
                      Required="true"
                      Disabled="IsLoading" />

    </DialogContent>

    <DialogActions>

        <MudButton OnClick="Cancel"
                   Disabled="IsLoading">
            Cancel
        </MudButton>

        <MudButton Color="Color.Primary"
                   OnClick="Save"
                   Disabled="@IsSaveDisabled">
            Save
        </MudButton>

    </DialogActions>

</MudDialog>