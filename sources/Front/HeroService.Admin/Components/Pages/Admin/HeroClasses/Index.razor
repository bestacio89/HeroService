@namespace HeroService.Admin.Components.Pages.Admin.HeroClasses

@page "/admin/hero-classes"

<MudPaper Class="pa-4">

    <MudStack Row="true"
              Justify="Justify.SpaceBetween"
              AlignItems="AlignItems.Center"
              Class="mb-2">

        <MudStack Spacing="0">
            <MudText Typo="Typo.h5">Hero Classes</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                Combat roles and archetype definitions
            </MudText>
        </MudStack>

        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   OnClick="OpenCreateDialog">
            Create Class
        </MudButton>

    </MudStack>

    <MudDivider Class="mb-3" />

    @if (IsLoading)
    {
        <MudProgressLinear Indeterminate="true" />
    }
    else if (!Items.Any())
    {
        <MudAlert Severity="Severity.Info" Class="mb-2">
            No hero classes defined.
        </MudAlert>
    }
    else
    {
        <MudTable Items="Items"
                  Hover="true"
                  Dense="true">

            <HeaderContent>
                <MudTh>Name</MudTh>
                <MudTh Style="width:140px;">Actions</MudTh>
            </HeaderContent>

            <RowTemplate Context="item">

                <MudTd>
                    <MudText Typo="Typo.subtitle2">
                        @item.Name
                    </MudText>
                </MudTd>

                <MudTd>
                    <MudIconButton Icon="@Icons.Material.Filled.Visibility"
                                   Size="Size.Small"
                                   OnClick="@(() => OpenDetails(item))" />
                </MudTd>

            </RowTemplate>

        </MudTable>
    }

</MudPaper>