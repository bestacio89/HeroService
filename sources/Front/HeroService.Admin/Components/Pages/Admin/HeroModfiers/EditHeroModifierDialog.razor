@namespace HeroService.Admin.Components.Pages.Admin.HeroModifiers

@using HeroService.Contracts.Commands.Modifiers

<MudExpansionPanel Text="Combat Modifier Overrides">

    <MudGrid Spacing="2">

        <MudItem xs="6">
            <MudNumericField T="float?"
                             Label="Health Multiplier"
                             @bind-Value="Model.HealthMultiplier" />
        </MudItem>

        <MudItem xs="6">
            <MudNumericField T="float?"
                             Label="Mana Multiplier"
                             @bind-Value="Model.ManaMultiplier" />
        </MudItem>

        <MudItem xs="6">
            <MudNumericField T="float?"
                             Label="Attack Damage Multiplier"
                             @bind-Value="Model.AttackDamageMultiplier" />
        </MudItem>

        <MudItem xs="6">
            <MudNumericField T="float?"
                             Label="Magic Damage Multiplier"
                             @bind-Value="Model.MagicDamageMultiplier" />
        </MudItem>

        <MudItem xs="6">
            <MudNumericField T="float?"
                             Label="Attack Speed Multiplier"
                             @bind-Value="Model.AttackSpeedMultiplier" />
        </MudItem>

        <MudItem xs="6">
            <MudNumericField T="float?"
                             Label="Cooldown Reduction Multiplier"
                             @bind-Value="Model.CooldownReductionMultiplier" />
        </MudItem>

        <MudItem xs="6">
            <MudNumericField T="float?"
                             Label="Armor Multiplier"
                             @bind-Value="Model.ArmorMultiplier" />
        </MudItem>

        <MudItem xs="6">
            <MudNumericField T="float?"
                             Label="Magic Resistance Multiplier"
                             @bind-Value="Model.MagicResistanceMultiplier" />
        </MudItem>

        <MudItem xs="6">
            <MudNumericField T="float?"
                             Label="Shield Strength Multiplier"
                             @bind-Value="Model.ShieldStrengthMultiplier" />
        </MudItem>

        <MudItem xs="6">
            <MudNumericField T="float?"
                             Label="Movement Speed Multiplier"
                             @bind-Value="Model.MovementSpeedMultiplier" />
        </MudItem>

    </MudGrid>

</MudExpansionPanel>