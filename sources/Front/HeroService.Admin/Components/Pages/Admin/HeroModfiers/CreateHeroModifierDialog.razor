@namespace HeroService.Admin.Components.Pages.Admin.HeroModifiers
<MudDialog>

    <DialogContent>

        <MudStack Spacing="3">

            <HeroSelector Model="Model" />

            <HeroModifierStatsEditor Model="Model" />

        </MudStack>

    </DialogContent>


    <DialogActions>

        <MudButton Variant="Variant.Text"
                   OnClick="Cancel">
            Cancel
        </MudButton>


        <MudButton Color="Color.Primary"
                   Variant="Variant.Filled"
                   Disabled="Saving"
                   OnClick="CreateModifier">
            Create
        </MudButton>

    </DialogActions>

</MudDialog>