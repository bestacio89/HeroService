@namespace HeroService.Admin.Components.Pages.Admin.Skills

@page "/admin/skills/create"

<MudPaper Class="pa-4">

    <MudText Typo="Typo.h6">
        Create Skill
    </MudText>

    <MudDivider Class="my-3" />


    <MudTextField Label="Name"
                  @bind-Value="Model.Name" />


    <MudSelect T="SkillType"
               Label="Skill Type"
               @bind-Value="Model.SkillType">

        @foreach (var type in Enum.GetValues<SkillType>())
        {
            <MudSelectItem Value="@type">
                @type
            </MudSelectItem>
        }

    </MudSelect>


    <MudDivider Class="my-3" />


    <SkillBaseStatsEditor Model="Model" />


    <MudDivider Class="my-3" />


    <SkillLoreEditor Model="Model.Lore" />


    <MudDivider Class="my-3" />


    <SkillEffectsEditor Model="Model.Effects" />


    <MudButton Class="mt-4"
               Color="Color.Primary"
               OnClick="Save">
        Save
    </MudButton>

</MudPaper>