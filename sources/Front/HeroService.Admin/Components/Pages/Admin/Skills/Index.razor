@page "/admin/skills"
@using HeroService.Client.Http.Abstractions

@using MudBlazor
@inject ISkillClient Client
@inject NavigationManager Nav
@inject IDialogService DialogService

<MudPaper Class="pa-4">

    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">

        <MudText Typo="Typo.h6">Skills</MudText>

        <MudButton Color="Color.Primary"
                   OnClick="@(() => Nav.NavigateTo("/admin/skills/create"))">
            Create Skill
        </MudButton>

    </MudStack>

    <MudDivider Class="my-3" />

    <MudTable Items="Items" Hover="true" Dense="true">

        <HeaderContent>
            <MudTh>Name</MudTh>
            <MudTh>Type</MudTh>
        </HeaderContent>

        <RowTemplate>
            <MudTd>@context.Name</MudTd>
            <MudTd>@context.SkillType</MudTd>
        </RowTemplate>

    </MudTable>

</MudPaper>

@code {
    private IReadOnlyCollection<SkillDto> Items = [];

    protected override async Task OnInitializedAsync()
        => Items = await Client.GetAllAsync();
}