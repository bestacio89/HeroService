@namespace HeroService.Admin.Components.Pages.Admin.Skills

<MudExpansionPanel Text="Effects">

    <MudStack Row="true" Spacing="2">

        <MudButton Color="Color.Primary"
                   OnClick="AddEffect">
            Add Effect
        </MudButton>

    </MudStack>


    @if (_effects.Count == 0)
    {
        <MudText Typo="Typo.caption"
                 Class="mt-2">
            No effects defined.
        </MudText>
    }


    @for (int i = 0; i < _effects.Count; i++)
    {
        var index = i;

        <MudPaper Class="pa-3 mt-3"
                  Elevation="1">

            <!-- keep existing effect editor markup here unchanged -->

        </MudPaper>
    }

</MudExpansionPanel>