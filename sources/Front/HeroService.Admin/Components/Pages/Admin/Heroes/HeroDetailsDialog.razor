@namespace HeroService.Admin.Components.Pages.Admin.Heroes

<MudDialog>

    <DialogContent>

        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-2">
            <MudText Typo="Typo.h6">@Hero.Name</MudText>
            <MudChip T="string" Color="Color.Primary" Size="Size.Small">@Hero.Class?.Name</MudChip>
        </MudStack>

        <MudStack Row="true" Spacing="1" Class="mb-3">
            @if (Hero.Affiliation?.Mythology?.Name is { } mythology)
            {
                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@mythology</MudChip>
            }

            @if (Hero.Affiliation?.Culture?.Name is { } culture)
            {
                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@culture</MudChip>
            }

            @if (Hero.Affiliation?.Archetype?.Name is { } archetype)
            {
                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@archetype</MudChip>
            }
        </MudStack>

        <MudDivider Class="mb-3" />

        <MudText Typo="Typo.subtitle2" Class="mb-2">
            Base Stats
        </MudText>

        <MudGrid Spacing="2">

            <MudItem xs="6" sm="4">
                <MudText Typo="Typo.body2">Health: @Hero.BaseStats.BaseHealth</MudText>
            </MudItem>

            <MudItem xs="6" sm="4">
                <MudText Typo="Typo.body2">Mana: @Hero.BaseStats.BaseMana</MudText>
            </MudItem>

            <MudItem xs="6" sm="4">
                <MudText Typo="Typo.body2">Attack Damage: @Hero.BaseStats.BaseAttackDamage</MudText>
            </MudItem>

            <MudItem xs="6" sm="4">
                <MudText Typo="Typo.body2">Ability Power: @Hero.BaseStats.BaseMagicDamage</MudText>
            </MudItem>

            <MudItem xs="6" sm="4">
                <MudText Typo="Typo.body2">Ignore Enemy Defense: @Hero.BaseStats.BaseIgnoreEnemyDefense</MudText>
            </MudItem>

            <MudItem xs="6" sm="4">
                <MudText Typo="Typo.body2">Attack Speed: @Hero.BaseStats.BaseAttackSpeed</MudText>
            </MudItem>

            <MudItem xs="6" sm="4">
                <MudText Typo="Typo.body2">Cast Speed: @Hero.BaseStats.BaseCastSpeed</MudText>
            </MudItem>

            <MudItem xs="6" sm="4">
                <MudText Typo="Typo.body2">Crit Chance: @Hero.BaseStats.BaseCritChance</MudText>
            </MudItem>

            <MudItem xs="6" sm="4">
                <MudText Typo="Typo.body2">Crit Multiplier: @Hero.BaseStats.BaseCritDamageMultiplier</MudText>
            </MudItem>

            <MudItem xs="6" sm="4">
                <MudText Typo="Typo.body2">Armor: @Hero.BaseStats.BaseArmor</MudText>
            </MudItem>

            <MudItem xs="6" sm="4">
                <MudText Typo="Typo.body2">Magic Resistance: @Hero.BaseStats.BaseMagicResistance</MudText>
            </MudItem>

            <MudItem xs="6" sm="4">
                <MudText Typo="Typo.body2">Damage Reduction: @Hero.BaseStats.BaseDamageReduction</MudText>
            </MudItem>

            <MudItem xs="6" sm="4">
                <MudText Typo="Typo.body2">Shield Multiplier: @Hero.BaseStats.BaseShieldStrengthMultiplier</MudText>
            </MudItem>

            <MudItem xs="6" sm="4">
                <MudText Typo="Typo.body2">Movement Speed: @Hero.BaseStats.BaseMovementSpeed</MudText>
            </MudItem>

            <MudItem xs="6" sm="4">
                <MudText Typo="Typo.body2">Attack Range: @Hero.BaseStats.BaseAttackRange</MudText>
            </MudItem>

            <MudItem xs="6" sm="4">
                <MudText Typo="Typo.body2">Cooldown Reduction: @Hero.BaseStats.BaseCooldownReduction</MudText>
            </MudItem>

            <MudItem xs="6" sm="4">
                <MudText Typo="Typo.body2">Resource Regen: @Hero.BaseStats.BaseResourceRegeneration</MudText>
            </MudItem>

        </MudGrid>

        <MudDivider Class="my-3" />

        <MudText Typo="Typo.subtitle2" Class="mb-2">
            Skill Kit
        </MudText>

        @if (IsLoadingSkills)
        {
            <MudProgressCircular Indeterminate="true" Size="Size.Small" />
        }
        else
        {
            <MudGrid Spacing="2">

                <MudItem xs="12" sm="6">
                    <MudText Typo="Typo.body2">Passive: @PassiveSkillName</MudText>
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudText Typo="Typo.body2">Primary: @PrimarySkillName</MudText>
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudText Typo="Typo.body2">Secondary: @SecondarySkillName</MudText>
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudText Typo="Typo.body2">Tertiary: @TertiarySkillName</MudText>
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudText Typo="Typo.body2">Ultimate: @UltimateSkillName</MudText>
                </MudItem>

            </MudGrid>
        }

    </DialogContent>

    <DialogActions>
        <MudButton OnClick="Close">
            Close
        </MudButton>
    </DialogActions>

</MudDialog>