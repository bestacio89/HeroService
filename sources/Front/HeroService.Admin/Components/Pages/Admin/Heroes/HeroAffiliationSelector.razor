@namespace HeroService.Admin.Components.Pages.Admin.Heroes

<MudGrid Spacing="2">

    <MudItem xs="12" sm="6">
        <MudSelect T="Guid"
                   Label="Hero Class"
                   @bind-Value="Model.HeroClassId">
            @foreach (var item in HeroClasses)
            {
                <MudSelectItem T="Guid" Value="@item.Id">
                    @item.Name
                </MudSelectItem>
            }
        </MudSelect>
    </MudItem>

    <MudItem xs="12" sm="6">
        <MudSelect T="Guid"
                   Label="Mythology"
                   @bind-Value="Model.MythologyTypeId">
            @foreach (var item in Mythologies)
            {
                <MudSelectItem T="Guid" Value="@item.Id">
                    @item.Name
                </MudSelectItem>
            }
        </MudSelect>
    </MudItem>

    <MudItem xs="12" sm="6">
        <MudSelect T="Guid"
                   Label="Origin Culture"
                   @bind-Value="Model.OriginCultureId">
            @foreach (var item in Cultures)
            {
                <MudSelectItem T="Guid" Value="@item.Id">
                    @item.Name
                </MudSelectItem>
            }
        </MudSelect>
    </MudItem>

    <MudItem xs="12" sm="6">
        <MudSelect T="Guid"
                   Label="Origin Archetype"
                   @bind-Value="Model.OriginArchetypeId">
            @foreach (var item in Archetypes)
            {
                <MudSelectItem T="Guid" Value="@item.Id">
                    @item.Name
                </MudSelectItem>
            }
        </MudSelect>
    </MudItem>

</MudGrid>