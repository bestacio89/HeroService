@namespace HeroService.Admin.Components.Pages.Admin.Heroes

@page "/admin/heroes/create"

<MudPaper Class="pa-4">

    <MudText Typo="Typo.h5">
        Create Hero
    </MudText>

    <MudDivider Class="my-2" />

    <MudStack Spacing="3">

        <MudTextField Label="Name"
                      @bind-Value="Model.Name" />

        <HeroAffiliationSelector Model="Model" />

        <HeroBaseStatsEditor Model="Model" />

        <HeroSkillKitEditor Model="Model.SkillKit" />

        <HeroLoreEditor Model="Model" />

        <MudButton Color="Color.Primary"
                   Variant="Variant.Filled"
                   OnClick="CreateHero">
            Create
        </MudButton>

    </MudStack>

</MudPaper>