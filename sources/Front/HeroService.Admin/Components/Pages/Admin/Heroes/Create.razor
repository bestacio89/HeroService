@page "/admin/heroes/create"
@inject IHeroClient HeroClient
@inject IDialogService DialogService

<MudPaper Class="pa-4">

    <MudText Typo="Typo.h5">Create Hero</MudText>

    <MudDivider Class="my-2" />

    <MudStack Spacing="3">

        <MudTextField Label="Name"
                      @bind-Value="Model.Name" />

        <HeroAffiliationSelector Model="Model" />

        <HeroBaseStatsEditor Model="Model" />

        <HeroSkillKitEditor Model="Model.SkillKit" />

        <HeroLoreEditor Model="Model" />

        <MudButton Color="Color.Primary"
                   Variant="Variant.Filled"
                   OnClick="CreateHero">
            Create
        </MudButton>

    </MudStack>

</MudPaper>
@code {
    private HeroCreateRequestDto Model = new();

    private async Task CreateHero()
    {
        var id = await HeroClient.CreateAsync(Model);

        // optional navigation later
    }
}