@namespace HeroService.Admin.Components.Pages.Admin.Heroes

@page "/admin/heroes"

<PageTitle>Heroes | HeroService</PageTitle>

<MudStack Spacing="4" Class="page-stack">
    <div class="page-heading">
        <div>
            <MudText Typo="Typo.overline" Class="eyebrow">CATALOGUE</MudText>
            <MudText Typo="Typo.h4" Class="page-title">Heroes</MudText>
            <MudText Typo="Typo.body1" Color="Color.Secondary">
                Browse the roster and explore each hero's classification.
            </MudText>
        </div>
        <MudTextField @bind-Value="_search"
                      Placeholder="Search heroes or mythology"
                      AriaLabel="Search heroes"
                      Variant="Variant.Outlined"
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search"
                      Immediate="true"
                      DebounceInterval="200"
                      Clearable="true"
                      Class="hero-search" />
    </div>

    @if (_isLoading)
    {
        <MudGrid Spacing="3">
            @for (var i = 0; i < 6; i++)
            {
                <MudItem xs="12" sm="6" lg="4" xl="3">
                    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="176px" Animation="Animation.Pulse" />
                </MudItem>
            }
        </MudGrid>
    }
    else if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">
            <MudText Typo="Typo.subtitle1">Heroes could not be loaded</MudText>
            <MudText Typo="Typo.body2">@_errorMessage</MudText>
            <MudButton Class="mt-3" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Refresh" OnClick="LoadHeroesAsync">
                Try again
            </MudButton>
        </MudAlert>
    }
    else
    {
        <MudGrid Spacing="3" Class="hero-summary-grid">
            <MudItem xs="12" sm="4">
                <MudPaper Class="metric-card" Elevation="0">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">TOTAL HEROES</MudText>
                    <MudText Typo="Typo.h4" Class="metric-value">@_heroes.Count</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Available in the catalogue</MudText>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudPaper Class="metric-card" Elevation="0">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">HERO CLASSES</MudText>
                    <MudText Typo="Typo.h4" Class="metric-value">@_classCount</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Distinct classifications</MudText>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudPaper Class="metric-card" Elevation="0">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">MYTHOLOGIES</MudText>
                    <MudText Typo="Typo.h4" Class="metric-value">@_mythologyCount</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Represented traditions</MudText>
                </MudPaper>
            </MudItem>
        </MudGrid>

        <div class="section-heading">
            <MudText Typo="Typo.h6">Roster</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                @FilteredHeroes.Count() result@(FilteredHeroes.Count() == 1 ? "" : "s")
            </MudText>
        </div>

        @if (_heroes.Count == 0)
        {
            <MudPaper Class="empty-state" Elevation="0">
                <MudIcon Icon="@Icons.Material.Outlined.Shield" Size="Size.Large" Color="Color.Secondary" />
                <MudText Typo="Typo.h6">No heroes yet</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">The catalogue is empty. Once heroes are available, they will appear here.</MudText>
            </MudPaper>
        }
        else if (!FilteredHeroes.Any())
        {
            <MudPaper Class="empty-state" Elevation="0">
                <MudIcon Icon="@Icons.Material.Outlined.SearchOff" Size="Size.Large" Color="Color.Secondary" />
                <MudText Typo="Typo.h6">No matching heroes</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">Try a different name, class or mythology.</MudText>
                <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="@ClearSearch">Clear search</MudButton>
            </MudPaper>
        }
        else
        {
            <MudGrid Spacing="3">
                @foreach (var hero in FilteredHeroes)
                {
                    <MudItem xs="12" sm="6" lg="4" xl="3" @key="hero.Id">
                        <MudCard Class="hero-card" Elevation="0">
                            <MudCardContent Class="hero-card-content">
                                <div class="hero-card-mark">
                                    <MudIcon Icon="@Icons.Material.Filled.Shield" Size="Size.Large" />
                                </div>
                                <MudText Typo="Typo.h6" Class="hero-card-title">@hero.Name</MudText>
                                <MudText Typo="Typo.body2" Color="Color.Secondary">
                                    @(hero.Class?.Name ?? "Unclassified")
                                </MudText>
                                <MudDivider Class="my-3" />
                                <div class="hero-card-meta">
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">MYTHOLOGY</MudText>
                                    <MudText Typo="Typo.body2">@(hero.Affiliation?.Mythology?.Name ?? "Not assigned")</MudText>
                                </div>
                                <div class="hero-card-meta">
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">ARCHETYPE</MudText>
                                    <MudText Typo="Typo.body2">@(hero.Affiliation?.Archetype?.Name ?? "Not assigned")</MudText>
                                </div>
                            </MudCardContent>
                            <MudCardActions Class="hero-card-actions">
                                <MudButton FullWidth="true"
                                           Variant="Variant.Outlined"
                                           Color="Color.Primary"
                                           EndIcon="@Icons.Material.Filled.ArrowForward"
                                           Disabled="@_openingHeroIds.Contains(hero.Id)"
                                           OnClick="@(() => OpenDetailsAsync(hero))">
                                    @(_openingHeroIds.Contains(hero.Id) ? "Loading details…" : "View details")
                                </MudButton>
                            </MudCardActions>
                        </MudCard>
                    </MudItem>
                }
            </MudGrid>
        }
    }
</MudStack>