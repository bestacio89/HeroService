@namespace HeroService.Admin.Components.Pages.Admin.Heroes

@if (_loadError is not null)
{
    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">
        @_loadError
        <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="LoadSkillsAsync">Retry</MudButton>
    </MudAlert>
}
else if (!_isLoading && Skills.Count == 0)
{
    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
        No skills are available. Create skills before assigning a hero skill kit.
    </MudAlert>
}

<MudExpansionPanels>

    <MudExpansionPanel Text="Skill Kit">

        <MudGrid Spacing="2">

            <MudItem xs="12" sm="6">
                <MudSelect T="Guid"
                           Disabled="@(_isLoading || _loadError is not null || Skills.Count == 0)"
                           Label="Passive Skill"
                           @bind-Value="Model.PassiveSkillId">
                    @foreach (var skill in Skills)
                    {
                        <MudSelectItem T="Guid" Value="@skill.Id">
                            @skill.Name
                        </MudSelectItem>
                    }
                </MudSelect>
            </MudItem>

            <MudItem xs="12" sm="6">
                <MudSelect T="Guid"
                           Disabled="@(_isLoading || _loadError is not null || Skills.Count == 0)"
                           Label="Primary Skill"
                           @bind-Value="Model.PrimarySkillId">
                    @foreach (var skill in Skills)
                    {
                        <MudSelectItem T="Guid" Value="@skill.Id">
                            @skill.Name
                        </MudSelectItem>
                    }
                </MudSelect>
            </MudItem>

            <MudItem xs="12" sm="6">
                <MudSelect T="Guid"
                           Disabled="@(_isLoading || _loadError is not null || Skills.Count == 0)"
                           Label="Secondary Skill"
                           @bind-Value="Model.SecondarySkillId">
                    @foreach (var skill in Skills)
                    {
                        <MudSelectItem T="Guid" Value="@skill.Id">
                            @skill.Name
                        </MudSelectItem>
                    }
                </MudSelect>
            </MudItem>

            <MudItem xs="12" sm="6">
                <MudSelect T="Guid"
                           Disabled="@(_isLoading || _loadError is not null || Skills.Count == 0)"
                           Label="Tertiary Skill"
                           @bind-Value="Model.TertiarySkillId">
                    @foreach (var skill in Skills)
                    {
                        <MudSelectItem T="Guid" Value="@skill.Id">
                            @skill.Name
                        </MudSelectItem>
                    }
                </MudSelect>
            </MudItem>

            <MudItem xs="12" sm="6">
                <MudSelect T="Guid"
                           Disabled="@(_isLoading || _loadError is not null || Skills.Count == 0)"
                           Label="Ultimate Skill"
                           @bind-Value="Model.UltimateSkillId">
                    @foreach (var skill in Skills)
                    {
                        <MudSelectItem T="Guid" Value="@skill.Id">
                            @skill.Name
                        </MudSelectItem>
                    }
                </MudSelect>
            </MudItem>

        </MudGrid>

    </MudExpansionPanel>

</MudExpansionPanels>