<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- Pin patched transitive package versions through central package management. -->
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <!-- Franz.Common packages -->
    <PackageVersion Include="Franz.Common.*" Version="2.3.3" />
    <PackageVersion Include="Franz.Common.Business" Version="2.3.3" />
    <PackageVersion Include="Franz.Common.Caching" Version="2.3.3" />
    <PackageVersion Include="Franz.Common.DependencyInjection" Version="2.3.3" />
    <PackageVersion Include="Franz.Common.EntityFramework" Version="2.3.3" />
    <PackageVersion Include="Franz.Common.EntityFramework.PostGres" Version="2.3.3" />
    <PackageVersion Include="Franz.Common.Errors" Version="2.3.3" />
    <PackageVersion Include="Franz.Common.Hosting" Version="2.3.3" />
    <PackageVersion Include="Franz.Common.Http" Version="2.3.3" />
    <PackageVersion Include="Franz.Common.Http.Bootstrap" Version="2.3.3" />
    <PackageVersion Include="Franz.Common.Http.Client" Version="2.3.3" />
    <PackageVersion Include="Franz.Common.Http.EntityFramework" Version="2.3.3" />
    <PackageVersion Include="Franz.Common.Logging" Version="2.3.3" />
    <PackageVersion Include="Franz.Common.Mediator" Version="2.3.3" />
    <PackageVersion Include="Franz.Common.Mediator.Polly" Version="2.3.3" />
    <PackageVersion Include="Franz.Common.Mediator.OpenTelemetry" Version="2.3.3" />
    <PackageVersion Include="Franz.Common.Mapping" Version="2.3.3" />
    <PackageVersion Include="Franz.Common.Messaging.Bootstrap" Version="2.3.3" />
    <PackageVersion Include="Franz.Common.Messaging.EntityFramework" Version="2.3.3" />
    <PackageVersion Include="Franz.Common.Messaging.KafKa" Version="2.3.3" />
    <!-- Microsoft packages -->
    <PackageVersion Include="Microsoft.AspNetCore.Http.Abstractions" Version="2.3.11" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Core" Version="2.3.11" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Common" Version="5.6.0" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.13" />
    <PackageVersion Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.23.0" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.13" />
    <!-- Security fixes: patched .NET 10 package versions for transitive advisories. -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <PackageVersion Include="System.Security.Cryptography.Xml" Version="10.0.13" />
    <!-- Third-party -->
    <PackageVersion Include="Confluent.Kafka" Version="2.13" />
    <PackageVersion Include="coverlet.collector" Version="10.0.1" />
    <PackageVersion Include="MudBlazor" Version="9.7.0" />
    <PackageVersion Include="Testcontainers" Version="4.16.0" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.16.0" />
    <PackageVersion Include="Testcontainers.Redis" Version="4.16.0" />
    <PackageVersion Include="Swashbuckle.AspNetCore" Version="10.2.3" />
    <PackageVersion Include="AspNetCoreRateLimit" Version="5.0.0" />
    <PackageVersion Include="Refit" Version="13.1.0" />
    <!-- Testing -->
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="FluentAssertions" Version="6.8.0" />
    <PackageVersion Include="Moq" Version="5.3.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageVersion Include="NetArchTest.Rules" Version="1.3.2" />
    <PackageVersion Include="TngTech.ArchUnitNET.xUnit" Version="0.13.3" />
  </ItemGroup>
</Project>